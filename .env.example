# The domain the frontend is served from. nginx allows CORS for this origin
# only, so it has to match where the app actually answers.
PUBLIC_DOMAIN=streamhub.example.com

DATABASE_URL=postgresql://streamhub:streamhub@postgres:5432/streamhub?schema=public
POSTGRES_DB=streamhub
POSTGRES_USER=streamhub
POSTGRES_PASSWORD=streamhub

# Required. Signs every access token, so a known value lets anyone mint one for
# any account including the administrator. The server refuses to start on a
# placeholder or anything shorter than 32 characters.
#
# Run this in a shell and paste the output after the = below. This file is read
# literally — it does not run commands — so a $(...) written here is stored as
# those characters and is not a secret at all:
#
#   openssl rand -hex 32
#
# Or append a fresh one straight to your .env:
#
#   echo "JWT_SECRET=$(openssl rand -hex 32)" >> .env
#
# Hex rather than base64 so the value has no characters that .env parsing or
# compose interpolation could treat as special.
#
# Changing this signs everyone out, which is the intended effect.
JWT_SECRET=

# Required only on a brand new database, to create the first administrator. The
# server refuses to seed one with "admin" or anything shorter than 8 characters.
# An instance that already has an admin ignores this.
#
#   openssl rand -hex 16
ADMIN_PASSWORD=

# Access token lifetime; the realtime socket closes and re-authenticates when it
# lapses. Clients renew silently, so this is invisible when refresh works — if
# devices are visibly signing out on this timescale, look here for a low
# override before suspecting anything else.
ACCESS_TOKEN_TTL_SECONDS=14400

# How long a device may sit completely unused before it must sign in again.
# This is an idle limit, not a session length: every authenticated request
# slides the window forward, so any device in use never reaches it.
REFRESH_TOKEN_TTL_DAYS=90
REQUEST_TIMEOUT_MS=20000
STREAM_PROXY_TIMEOUT_MS=30000
