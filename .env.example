# The domain the frontend is served from. nginx allows CORS for this origin
# only, so it has to match where the app actually answers.
PUBLIC_DOMAIN=streamhub.example.com

DATABASE_URL=postgresql://streamhub:streamhub@postgres:5432/streamhub?schema=public
POSTGRES_DB=streamhub
POSTGRES_USER=streamhub
POSTGRES_PASSWORD=streamhub

# Required. Signs every access token, so a known value lets anyone mint one for
# any account including the administrator — the server refuses to start on a
# placeholder or anything shorter than 32 characters.
#   JWT_SECRET=$(openssl rand -base64 48)
JWT_SECRET=

# Required only on a brand new database, to create the first administrator. The
# server refuses to seed one with "admin" or anything shorter than 8 characters.
#   ADMIN_PASSWORD=$(openssl rand -base64 24)
ADMIN_PASSWORD=

# Access token lifetime; the realtime socket closes and re-authenticates when it
# lapses.
ACCESS_TOKEN_TTL_SECONDS=14400
REQUEST_TIMEOUT_MS=20000
STREAM_PROXY_TIMEOUT_MS=30000
